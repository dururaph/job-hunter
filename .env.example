# Copy to .env.local and fill in.

# Required for resume tailoring. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-haiku-5-5, the cheapest).
# Use claude-opus-5-5 for the highest-quality rewriting.
# ANTHROPIC_MODEL=

# Password for the deployed site. Leave unset locally to skip the login screen.
# Use a long, unique password in production.
# APP_PASSWORD=

# Database. Leave unset locally to use ./local.db.
# In production, create a free Turso database and use its libsql:// URL + token.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Protects GET /api/ingest if you trigger ingestion from Vercel Cron instead of GitHub Actions.
# CRON_SECRET=
